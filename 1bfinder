--// START LOADER IMMEDIATELY
local LoaderFinished = false
local LoaderError = nil

task.spawn(function()
    local success, err = pcall(ExecuteLoader)

    LoaderFinished = true

    if not success then
        LoaderError = tostring(err)
        warn("Brainrot Finder loader failed: " .. LoaderError)
    end
end)

--// 40-SECOND COUNTDOWN
for seconds = 40, 1, -1 do
    TimerLabel.Text = "Loading... " .. seconds .. "s"

    local progress = (41 - seconds) / 40

    TweenService:Create(
        Bar,
        TweenInfo.new(1, Enum.EasingStyle.Linear),
        {Size = UDim2.new(progress, 0, 1, 0)}
    ):Play()

    if seconds == 30 then
        Status.Text = "Stay tuned! There might be free stuff!"
    elseif seconds == 5 then
        Status.Text = "GG FREAKING EASY"
        Status.TextColor3 = Color3.fromRGB(200, 120, 255)
    end

    task.wait(1)
end

--// FINISH
TimerLabel.Text = "100%"
Bar.Size = UDim2.new(1, 0, 1, 0)

if LoaderError then
    Status.Text = "Loader failed. Check the error."
    Footer.Text = "LOADER ERROR"
elseif LoaderFinished then
    Status.Text = "GG FREAKING EASY"
    Footer.Text = "LOADING COMPLETE"
else
    Status.Text = "Still loading..."
    Footer.Text = "PLEASE WAIT"
end
